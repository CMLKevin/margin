# All fields are optional for a loopback-only installation.
# Jina can also be configured through the first-run browser guide.
# JINA_API_KEY=
# PORT=3000
# MARGIN_DATA_DIR=.margin
# MARGIN_MCP_TOKEN=
# For remote hosting: set a strong password and the exact public origin.
# MARGIN_HOST=0.0.0.0
# MARGIN_PASSWORD=
# MARGIN_PUBLIC_URL=https://margin.example.org
# Tests only: disable automatic source checks.
# MARGIN_DISABLE_SCHEDULER=1
