    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.5.0",
    "geist": "^1.9.0",
    "lucide-react": "^1.31.0",
    "marked": "18.1.2",
    "pixelarticons": "2.4.2",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
